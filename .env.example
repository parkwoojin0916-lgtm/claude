# Claude API key (하이라이트 최종 선별 + 제목/캡션 생성에 사용)
# 없어도 신호 기반(오디오/장면전환)으로만 동작합니다.
ANTHROPIC_API_KEY=

# 하이라이트 선별에 쓰는 모델
HIGHLIGHT_MODEL=claude-sonnet-5-5

# 전사 모델 크기: tiny / base / small / medium / large-v3
WHISPER_MODEL=base

# 작업 결과 저장 경로
DATA_DIR=data

# 동시에 처리할 작업 수
MAX_WORKERS=2

# 처리 가능한 영상 최대 길이(초). 초과 시 거부.
MAX_VIDEO_SECONDS=5400

# 유튜브 봇 차단 우회(정식 경로): 브라우저에서 내보낸 cookies.txt 경로
YTDLP_COOKIES_FILE=
# 로컬 실행이면 브라우저에서 직접 읽기 (chrome, firefox, edge ...)
YTDLP_COOKIES_FROM_BROWSER=
# yt-dlp에 넘길 추가 인자 (예: --proxy socks5://...)
YTDLP_EXTRA_ARGS=
